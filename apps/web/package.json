{
  "name": "@crm/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm env:load next dev",
    "build": "pnpm env:load next build",
    "start": "pnpm env:load next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "env:load": "dotenv -e ../../.env --"
