{
  "name": "@crm/api",
  "version": "0.0.1",
  "main": "dist/http/server.js",
  "scripts": {
    "dev": "pnpm env:load tsx watch src/http/server.ts",
    "db:seed": "pnpm --filter @crm/db db:seed",
    "db:generate": "pnpm --filter @crm/db db:generate",
    "db:migrate": "pnpm --filter @crm/db db:migrate",
    "db:push": "pnpm --filter @crm/db db:push",
    "db:studio": "pnpm --filter @crm/db db:studio",
    "env:load": "dotenv -e ../../.env --",
    "lint": "eslint . --ext .ts",
    "check-types": "tsc --noEmit",
    "build": "pnpm lint && tsup",
    "start": "node dist/http/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@crm/auth": "workspace:*",
    "@crm/cloudflare": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/env": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.2",
    "@scalar/fastify-api-reference": "^1.28.19",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.42.0",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "fastify-zod-openapi": "^4.1.1",
    "tsup": "^8.5.0",
    "zod": "^3.24.2",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@crm/eslint-config": "workspace:*",
    "@crm/prettier": "workspace:*",
    "@crm/typescript-config": "workspace:*",
    "@types/node": "^22.14.1",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "prettier": "@crm/prettier",
  "eslintConfig": {
    "extends": [
      "@crm/eslint-config/node"
    ]
  }
}
