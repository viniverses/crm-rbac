{
  "name": "@crm/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:seed": "pnpm env:load tsx src/seed.ts",
    "db:generate": "pnpm env:load drizzle-kit generate",
    "db:migrate": "pnpm env:load drizzle-kit migrate",
    "db:push": "pnpm env:load drizzle-kit push",
    "db:studio": "pnpm env:load drizzle-kit studio",
    "env:load": "dotenv -e .env -e ../../.env --",
    "lint": "eslint src drizzle.config.ts tsup.config.ts --ext .ts",
    "check-types": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@crm/env": "workspace:*",
    "@neondatabase/serverless": "^1.0.0",
    "bufferutil": "^4.0.9",
    "drizzle-orm": "^0.42.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@crm/eslint-config": "workspace:*",
    "@crm/prettier": "workspace:*",
    "@crm/typescript-config": "workspace:*",
    "@faker-js/faker": "^9.7.0",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.2",
    "chalk": "4.1.2",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "prettier": "@crm/prettier"
}
